# Contact form — powered by Resend (https://resend.com)
# 1. Sign up at https://resend.com (free tier: 100 emails/day)
# 2. Create an API key in your Resend dashboard
# 3. Copy this file to .env.local and paste your key below
# 4. Optionally verify your own domain in Resend and update the `from` address
#    in src/app/api/contact/route.ts

RESEND_API_KEY=re_your_api_key_here
